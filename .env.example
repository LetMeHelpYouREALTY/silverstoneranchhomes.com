# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# RealScout (optional — defaults are baked into lib/realscout/config.ts)
# REALSCOUT_AGENT_ENCODED_ID=QWdlbnQtMjI1MDUw
# Paste the content value from GSC → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics (already used in lib/analytics.ts)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Hosted Images (primary CDN). Git copies in public/images are the backup.
# Account hash and ID are public delivery values; never commit the API token.
# CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
# CLOUDFLARE_IMAGES_API_TOKEN=
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_VARIANT=public
# Flip to 1 only after `npm run images:cloudflare` verifies 200s on imagedelivery.net
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY=1

# Google Maps Embed (optional — iframe fallback is used when unset)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
